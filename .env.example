# Only needed when the multiplayer WebSocket server is hosted separately.
# Use wss:// for an HTTPS deployment.
VITE_SKYBREAK_WS_URL=

# Match worker only. Never prefix secrets below with VITE_.
SKYBREAK_ALLOWED_ORIGINS=https://skybreak-iota.vercel.app
HOST=0.0.0.0
PORT=8080
# Begin with the one-room / eight-client capacity covered by the scripted soak.
SKYBREAK_MAX_CLIENTS=8
SKYBREAK_MAX_ROOMS=1
# Optional voice provider values, configured through the server host's secret UI.
SKYBREAK_STUN_URLS=
SKYBREAK_TURN_URLS=
SKYBREAK_TURN_SECRET=
